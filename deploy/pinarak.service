[Unit]
Description=Desa Pinarak (pinarak.mfah.me)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/builds/pinarak
Environment=PORT=8026
Environment=HOST=0.0.0.0
Environment=DATA_DIR=/root/builds/pinarak/data
# Token admin Pemilu (Pak Kades): ISI nilai rahasia di unit yang terpasang di
# server (jangan commit nilainya ke repo). Kosong = endpoint admin selalu 403.
Environment=PINARAK_ADMIN_TOKEN=
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
