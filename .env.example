# Contoh environment untuk docker-compose Desa Pinarak.
# Salin menjadi ".env" di folder yang sama lalu GANTI semua nilai contoh.
# File .env asli JANGAN dibagikan / jangan masuk repo.

# Kredensial database PostgreSQL (dipakai service db & disusun menjadi
# DATABASE_URL untuk service app oleh docker-compose.yml).
POSTGRES_USER=pinarak
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=pinarak

# Token admin Pinarak: membuka periode pemilu & menandai fasilitas
# terbangun (header X-Admin-Token). Kosong = semua endpoint admin menolak.
PINARAK_ADMIN_TOKEN=ganti-dengan-token-acak-panjang
